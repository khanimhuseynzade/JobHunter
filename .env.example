# Neon Postgres connection string (https://neon.tech)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret shared with Vercel Cron (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=

# Gmail API (email -> status suggestions). See scripts/gmail-auth.ts for setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# LLM used to classify recruiter emails into status suggestions.
# Free Groq key (no credit card) from https://console.groq.com/keys
GROQ_API_KEY=
# Optional overrides:
# GROQ_MODEL=openai/gpt-oss-20b   (must support structured outputs)
# EMAIL_LOOKBACK=newer_than:2d -category:promotions -category:social
